{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "adapters",
    "tool/adaptive-semantic-pilot.ts",
    "tool/adaptive-review-pilot.ts",
    "tool/adaptive-read-benchmark.ts",
    "tool/adaptive-live-pilot.ts"
  ]
}
