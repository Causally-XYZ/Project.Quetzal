{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "adapters",
    "tool/adaptive-semantic-pilot.ts",
    "tool/adaptive-review-pilot.ts",
    "tool/adaptive-read-benchmark.ts",
    "tool/adaptive-live-pilot.ts",
    "tool/adaptive-retrieval-probe/host.ts",
    "tool/adaptive-retrieval-probe/deploy.ts",
    "tool/adaptive-retrieval-probe/multibody.ts",
    "tool/adaptive-eval/cli.ts",
    "tool/adaptive-eval/body.ts",
    "tool/adaptive-eval/development.ts",
    "tool/adaptive-eval/formal.ts",
    "tool/adaptive-eval/review-cli.ts"
  ]
}
